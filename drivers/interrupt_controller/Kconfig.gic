if CPU_CORTEX

config GIC
	bool

config GIC_V1
	def_bool DT_HAS_ARM_GIC_V1_ENABLED
	select GIC
	help
	  The ARM Generic Interrupt Controller v1 (e.g. PL390) works with the
	  ARM Cortex-family processors.

config GIC_V2
	def_bool DT_HAS_ARM_GIC_V2_ENABLED
	select GIC
	help
	  The ARM Generic Interrupt Controller v2 (e.g. GIC-400) works with the
	  ARM Cortex-family processors.

config GIC_V3
	def_bool DT_HAS_ARM_GIC_V3_ENABLED
	select GIC
	help
	  The ARM Generic Interrupt Controller v3 (e.g. GIC-500 and GIC-600)
	  works with the ARM Cortex-family processors.

config GIC_VER
	int
	depends on GIC
	default 1 if GIC_V1
	default 2 if GIC_V2
	default 3 if GIC_V3

config GIC_SINGLE_SECURITY_STATE
	bool
	depends on GIC_V3
	help
	  Some ARM Cortex-family processors only supports single security
	  state. Others must set it from EL3 to operate in single-security mode.

config GIC_V3_RDIST_MATCHING_AFF0_ONLY
	bool
	depends on GIC_V3
	default y if CPU_CORTEX_R52
	help
	  Some platforms only use aff0 to match mpdir and GICR.aff. With this
	  enabled, we find the target redistributor by comparing the aff0 only.

config GIC_V3_ITS
	bool "GIC v3 Interrupt Translation Service"
	depends on GIC_V3
	# ITS generates Non-secure Group 1 LPI interrupts, requiring EL1NS
	select ARMV8_A_NS
	select DYNAMIC_INTERRUPTS
	select KERNEL_MEM_POOL
	help
	  Support for the optional Interrupt Translation Service used to translate
	  hardware interrupt from PCIe MSI messages for example. Please note
	  that ITS allocates its tables from the system heap, whose minimum size
	  HEAP_MEM_POOL_ADD_SIZE_GIC_V3_ITS below accounts for.

# The GICv3 and ITS drivers allocate, from the system heap:
# - LPI property table: one 64K table, 4K aligned, shared by all CPUs
# - LPI pending table: one 64K table, 64K aligned, per redistributor/CPU
# - Devices table: 512K for 16-bit DeviceIDs with 8-byte entries
# - Interrupt collections table: at least one hardware-supported page
#
# Device and collection table pages can be 64K. The heap allocator temporarily
# overallocates for alignment, in addition to keeping per-allocation metadata
# Reserve 1 MiB for one CPU and 2 MiB for SMP to cover four CPUs, 64K table
# pages and alignment overhead, with room for per-device interrupt translations
# Larger CPU counts or hardware tables may need a higher HEAP_MEM_POOL_SIZE
# Applications with measured requirements can use HEAP_MEM_POOL_IGNORE_MIN
config HEAP_MEM_POOL_ADD_SIZE_GIC_V3_ITS
	int
	default 2097152 if GIC_V3_ITS && SMP
	default 1048576 if GIC_V3_ITS

config GIC_SAFE_CONFIG
	bool "GIC Distributor Safe Configuration"
	depends on GIC
	help
	  Multiple operating systems may share one GIC distributor. When another OS
	  has already enabled the distributor, re-running full distributor init
	  can clobber its enables, targets, and priorities. When this option is
	  enabled, Zephyr skips GIC distributor initialization if the distributor
	  is already active. Per-IRQ affinity updates still occur from
	  arm_gic_irq_enable().
	  Applies to GICv1, GICv2, and GICv3.

	  Limitation (GICv1/GICv2): the per-IRQ affinity update in
	  arm_gic_irq_enable() is a read-modify-write of the shared
	  GICD_ITARGETSRn register and is not serialized across OSes. Two
	  independent Zephyr instances enabling the same shared SPI
	  concurrently may race and lose an update; concurrent enable of the
	  same shared SPI from multiple OSes is out of scope for this option.

config GIC_V3_RDIST_DMA_NONCOHERENT
	bool "GIC redistributor is DMA noncoherent"
	depends on GIC_V3
	help
	  GIC redistributor on some platforms is connected to a non-coherent
	  downstream interconnect, it needs to use Non-cacheable and Non-shareable
	  access attributes to access external memory.

config GIC_V3_ITS_DMA_NONCOHERENT
	bool "GIC ITS is DMA noncoherent"
	depends on GIC_V3_ITS
	help
	  GIC ITS on Some platform are connected to a non-coherent downstream
	  interconnect, it need to use Non-cacheable and Non-shareable access
	  attributes to access external memory.

endif # CPU_CORTEX
